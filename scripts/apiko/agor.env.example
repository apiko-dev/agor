# Copy to ~/.config/agor/agor.env (or /etc/agor/agor.env for systemd) and fill in.
# Keep the copy private: chmod 600.

# Database. Agor uses PostgreSQL, never SQLite.
AGOR_DB_DIALECT=postgresql
# Add ?sslmode=require for managed databases (Neon, Supabase, RDS, Railway).
DATABASE_URL=postgresql://agor:change-me@localhost:5432/agor

# Password of the first admin (admin@agor.live). Used once, when the users table is empty.
AGOR_ADMIN_PASSWORD=change-me-to-a-long-password

# Address the daemon listens on. Keep localhost unless a reverse proxy runs on another host.
DAEMON_HOST=localhost
DAEMON_PORT=3030

# Public URL, when Agor sits behind a reverse proxy.
# AGOR_BASE_URL=https://agor.example.com

# Agor state folder (config.yaml with secrets, repos, worktrees, logs). Defaults to ~/.agor.
# AGOR_HOME=/home/agor/.agor

# Install prefix for the built Agor. The binaries go to $AGOR_PREFIX/bin.
AGOR_PREFIX=$HOME/agor-runtime

# pstack commit installed by setup.sh.
PSTACK_REF=08547969e1dffaa6457ea65141cc62c1d9a2eef1
